MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=dsa_mind_mirror
# Optional server-side key; the extension sends the user's own key with each event.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# all | failed | none  (submits are always analysed)
ANALYZE_RUNS=all
PORT=3001
DASHBOARD_URL=http://localhost:5173
